{
  // Sample Angular workspace tsconfig (path aliases like a real project)
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@core/*": ["./src/app/core/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@env/*": ["./src/environments/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
